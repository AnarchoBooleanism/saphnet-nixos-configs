{
  // NOTE: This should be able to catch github-actions and docker-compose!

  // Overall Renovate config
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>AnarchoBooleanism/renovate-config#v5.0.0"
  ],

  // Package rules
  "packageRules": [
    // Package groups (for tightly-bound packages)
    {
      "groupName": "komodo",
      "matchFileNames": [
        "machines/control-server/komodo-control/compose.yaml", // Machine: control-server
        "machines/docker-host/komodo-periphery/compose.yaml" // Machine: docker-host
      ]
    },
    {
      "groupName": "reverse-proxy",
      "matchFileNames": [
        "machines/control-server/reverse-proxy/compose.yaml" // Machine: control-server
      ]
    },

    // Major/minor version pins
    {
      "matchFileNames": ["machines/control-server/komodo-control/compose.yaml"],
      "matchPackageNames": ["mongo"],
      "allowedVersions": "^8.0.0" // 9 came out, staying here until we figure it out
    },
  ]
}
